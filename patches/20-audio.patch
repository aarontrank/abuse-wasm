     if (!sound_enabled)
         return;
 
+#ifdef __EMSCRIPTEN__
+    // A suspended AudioContext never ends a source, so every sound started
+    // before the first user gesture would hold a channel and then all play at
+    // once on resume.
+    if (!EM_ASM_INT({ return SDL.audioContext && SDL.audioContext.state == 'running'; }))
+        return;
+#endif
+
     int channel = Mix_PlayChannel(-1, m_chunk, 0);
     if (channel > -1)
     {
         Mix_Volume(channel, volume);
+#ifdef __EMSCRIPTEN__
+        // Emscripten's Mix_SetPanning places a PannerNode at
+        // x = (right - left) / 255, z = 0.1, so the angle grows with
+        // atan(10 x) and a small offset already pans hard. Pick the x whose
+        // equal-power angle gives the share of right output panpot asks for.
+        double angle = ((255 - panpot) / 255.0 - 0.5) * M_PI;
+        // Clamp before the cast: tan() is ~1.6e16 at panpot 0 and 255.
+        double x = 255 * 0.1 * tan(angle);
+        int d = (int)lround(x < -255 ? -255 : x > 255 ? 255 : x);
+        Mix_SetPanning(channel, (255 - d) / 2, (255 - d) / 2 + d);
+#else
         Mix_SetPanning(channel, panpot, 255 - panpot);
+#endif
     }
 }
 
